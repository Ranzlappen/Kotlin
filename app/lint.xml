<?xml version="1.0" encoding="utf-8"?>
<!-- Lint policy, adapted from Ranzlappen/repo-standards android-lint.xml.
     Localization and accessibility issues are errors, not warnings — the
     Lastenheft requires full localization and an accessibility pass. -->
<lint>
    <!-- Generated code is not ours to fix. -->
    <issue id="all">
        <ignore path="**/build/**" />
        <ignore path="**/generated/**" />
    </issue>

    <!-- Localization: every user-facing string comes from resources. -->
    <issue id="HardcodedText" severity="error" />
    <issue id="MissingTranslation" severity="error" />

    <!-- Accessibility. -->
    <issue id="ContentDescription" severity="error" />
    <issue id="TouchTargetSizeCheck" severity="error" />
    <issue id="LabelFor" severity="error" />

    <!-- Hygiene. -->
    <issue id="UnusedResources" severity="warning" />

    <!-- Security. -->
    <issue id="SetJavaScriptEnabled" severity="error" />
    <issue id="ExportedReceiver" severity="error" />
    <issue id="ExportedService" severity="error" />
    <issue id="ExportedContentProvider" severity="error" />
</lint>
